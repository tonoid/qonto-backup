  "description": "Sauvegarde quotidienne et incrémentale d'un compte Qonto (transactions + justificatifs) sur disque local.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qonto-backup": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
